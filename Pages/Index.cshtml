@* CHATGPT Prompt

📚 Session ve Cookie Detayları:
Session'a: username, token değerlerini kaydet
Cookie'ye: username, token değerlerini yaz
Cookie süresi 30 dakika
Cookie HttpOnly = true, SameSite=Strict, Secure=false
🚪 Login Akışı:
Kullanıcı doğru bilgilerle login olursa Index sayfasına yönlendirilecek
Yanlış girişte hata mesajı gösterilecek
Session ve Cookie kontrolü yapılacak
Uyuşmuyorsa Login sayfasına yönlendirilecek
🚪 Logout Akışı:
Session temizlenecek
Cookie'ler silinecek
Kullanıcı Login sayfasına yönlendirilecek
🎨 UI Basit Olacak:
Bootstrap 5 kullan (yüksek görsellik şart değil)
Formlar düzgün hizalı olsun
Hata mesajları alert kutusu içinde gösterilsin *@

@page
@model ClassInfoRazorPages.Pages.IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Class Information</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .column-selected { background-color: red !important; }

        :root {
            --bg: #ffffff;
            --text: #333;
            --card-bg: #ffffff;
            --header-bg: #f0f0f0;
        }

        html[data-theme="dark"] {
            --bg: #121212;
            --text: #e0e0e0;
            --card-bg: #1e1e1e;
            --header-bg: #2c2c2c;
        }

        body { background: var(--bg); color: var(--text); }
        .bg-white { background-color: var(--card-bg) !important; }
        .table-primary th { background-color: var(--header-bg) !important; }

        #themeToggle {
            position: fixed; top: 1rem; right: 1rem;
            width: 3rem; height: 3rem;
            display: flex; align-items: center; justify-content: center;
            border-radius: 50%;
        }
        
    </style>
</head>
<body>
    <button id="themeToggle" class="btn btn-secondary">🌙</button>

    <section class="py-5">
        <div class="container">
            <div class="row g-4">
                <!-- Form -->
                <div class="col-lg-6">
                    <div class="bg-white p-4 rounded shadow">
                            <h3 class="mb-3">@((Model.IsEdit) ? "Update Class Info" : "Add Class Info")</h3>                        <form method="post">
                            <input type="hidden" asp-for="ClassInput.Id" />
                            <div class="mb-3">
                                <label asp-for="ClassInput.ClassName" class="form-label">Class Name</label>
                                <input asp-for="ClassInput.ClassName" class="form-control" />
                                <span asp-validation-for="ClassInput.ClassName" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ClassInput.StudentCount" class="form-label">Student Count</label>
                                <input asp-for="ClassInput.StudentCount" class="form-control" />
                                <span asp-validation-for="ClassInput.StudentCount" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ClassInput.Description" class="form-label">Description</label>
                                <textarea asp-for="ClassInput.Description" class="form-control"></textarea>
                                <span asp-validation-for="ClassInput.Description" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-success rounded-pill px-4 py-2 me-2">
                                @(Model.IsEdit ? "Update" : "Add")
                            </button>                            
                                @if (Model.IsEdit)
                            {
                                <a asp-page="./Index" class="btn btn-secondary ms-2">Cancel</a>
                            }
                        </form>
                    </div>
                </div>

                <!-- Table -->
                <div class="col-lg-6">
                    <div class="bg-white p-4 rounded shadow">
                        <h3 class="mb-3">Class List</h3>

                        <form method="get" class="mb-3">
                            <div class="input-group">
                                <input type="text" name="SearchClassName" value="@Model.SearchClassName" class="form-control" placeholder="Search by class name..." />
                                <button type="submit" class="btn btn-outline-secondary">Filter</button>
                            </div>
                        </form>

                        <form method="post" asp-page-handler="ExportJson">
                            <input type="hidden" name="SearchClassName" value="@Model.SearchClassName" />
                            <input type="hidden" name="PageNumber" value="@Model.PageNumber" />

                            <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th class="@(Model.SelectedColumns.Contains("ClassName") ? "selected-column" : "")">
                        <input type="checkbox" name="selectedColumns" value="ClassName" @(Model.SelectedColumns.Contains("ClassName") ? "checked" : "") />
                        Class Name
                    </th>
                    <th class="@(Model.SelectedColumns.Contains("StudentCount") ? "selected-column" : "")">
                        <input type="checkbox" name="selectedColumns" value="StudentCount" @(Model.SelectedColumns.Contains("StudentCount") ? "checked" : "") />
                        Student Count
                    </th>
                    <th class="@(Model.SelectedColumns.Contains("Description") ? "selected-column" : "")">
                        <input type="checkbox" name="selectedColumns" value="Description" @(Model.SelectedColumns.Contains("Description") ? "checked" : "") />
                        Description
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.FilteredClasses)
                {
                    <tr>
                        <td class="@(Model.SelectedColumns.Contains("ClassName") ? "selected-column" : "")">@item.ClassName</td>
                        <td class="@(Model.SelectedColumns.Contains("StudentCount") ? "selected-column" : "")">@item.StudentCount</td>
                        <td class="@(Model.SelectedColumns.Contains("Description") ? "selected-column" : "")">@item.Description</td>
                        <td>
                            <a asp-page="./Index" asp-route-editId="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                            <a asp-page="./Index" asp-route-deleteId="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
                            <input type="hidden" name="SearchClassName" value="@Model.SearchClassName" />
    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                            <button type="submit" class="btn btn-success mt-2">Export JSON</button>
                        </form>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <nav class="mt-3">
                                <ul class="pagination justify-content-center">
                                    @for (int i = 1; i <= Model.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                            <a class="page-link" href="?PageNumber=@i&SearchClassName=@Model.SearchClassName">@i</a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                        <a asp-page="/Logout" class="btn btn-danger float-end">Logout</a>

                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        const btn = document.getElementById('themeToggle');
        btn.addEventListener('click', () => {
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            if (isDark) {
                document.documentElement.removeAttribute('data-theme');
                localStorage.removeItem('theme');
                btn.textContent = '🌙';
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
                localStorage.setItem('theme', 'dark');
                btn.textContent = '☀️';
            }
        });
        window.addEventListener('DOMContentLoaded', () => {
            if (localStorage.getItem('theme') === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
                btn.textContent = '☀️';
            }
        });
    </script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const checkboxes = document.querySelectorAll('input[name="selectedColumns"]');
    const table = document.querySelector('table.table');

    function updateColumnColors() {
        const headerRow = table.querySelector('thead tr');
        const headers = Array.from(headerRow.children);
        const rows = table.querySelectorAll('tbody tr');

        checkboxes.forEach(checkbox => {
            let columnIndex;
            if (checkbox.value === "ClassName") columnIndex = 0;
            else if (checkbox.value === "StudentCount") columnIndex = 1;
            else if (checkbox.value === "Description") columnIndex = 2;
            else return;

            if (checkbox.checked) {
                // Header hücresini boya
                headers[columnIndex]?.classList.add('column-selected');
                // Tüm satırlardaki ilgili hücreleri boya
                rows.forEach(row => {
                    const cells = row.querySelectorAll('td');
                    if (cells[columnIndex]) {
                        cells[columnIndex].classList.add('column-selected');
                    }
                });
            } else {
                headers[columnIndex]?.classList.remove('column-selected');
                rows.forEach(row => {
                    const cells = row.querySelectorAll('td');
                    if (cells[columnIndex]) {
                        cells[columnIndex].classList.remove('column-selected');
                    }
                });
            }
        });
    }

    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', updateColumnColors);
    });

    // Sayfa yüklenince doğru görünmesi için
    updateColumnColors();
});
</script>



